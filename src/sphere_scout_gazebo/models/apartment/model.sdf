<?xml version="1.0"?>
<sdf version="1.9">
  <model name="apartment">
    <static>true</static>
    <link name="link">
      <!-- Visual only for now. A low-poly collision mesh comes next, before the robot drives in. -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://apartment/meshes/apartment.glb</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
